pkgname=bedrocknode-tunnel
pkgver={{.Version}}
pkgrel=1
pkgdesc="Bedrock Node Tunnel client for hosting a Minecraft Bedrock server behind CGNAT"
arch=('x86_64' 'aarch64')
url="{{.URL}}"
license=('Apache-2.0')
makedepends=('go')
source=("$pkgname-$pkgver.tar.gz::$url/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz")
sha256sums=('{{.SHA256}}')

build() {
  cd "$pkgname-$pkgver"
  export CGO_ENABLED=0
  go build -trimpath -buildmode=pie -mod=vendor -modcacherw \
    -ldflags "-s -w -X main.version=$pkgver" -o nethernet-client .
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 nethernet-client "$pkgdir/usr/bin/nethernet-client"
  install -Dm644 packaging/bedrocknode-tunnel.service "$pkgdir/usr/lib/systemd/user/bedrocknode-tunnel.service"
  install -Dm644 packaging/nethernet-client.1 "$pkgdir/usr/share/man/man1/nethernet-client.1"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
